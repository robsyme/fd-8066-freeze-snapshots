// Shared by both runs. ECR in the same AWS account as the compute environment.
wave {
    enabled = true
    freeze  = true
    build {
        repository      = '128997144437.dkr.ecr.us-east-1.amazonaws.com/fd-8066/wave'
        cacheRepository = '128997144437.dkr.ecr.us-east-1.amazonaws.com/fd-8066/wave-cache'
    }
}
fusion {
    enabled   = true
    snapshots = true
}
// Dev build: Fusion PR #1916 (2.5.16-fceb0fb). fusion.containerConfigUrl REPLACES Nextflow's
// snapshot manifest choice, so point at the PR's *snapshot* manifest (fusion-snap_amd64.json:
// dev Fusion + fusion-snapshot 1.8.0 + FUSION_SNAPSHOT_ENABLED=true). The plain
// fusion-amd64.json has no snapshot layer and would pass without exercising the fix.
fusion.containerConfigUrl = 'https://s3.eu-west-2.amazonaws.com/fusion-develop/snapshots/pr-1916/fusion-snap_amd64.json'
