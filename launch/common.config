// Shared by both runs. ECR in the same AWS account as the compute environment.
wave {
    enabled = true
    freeze  = true
    build {
        repository      = '128997144437.dkr.ecr.us-east-1.amazonaws.com/fd-8066/wave'
        cacheRepository = '128997144437.dkr.ecr.us-east-1.amazonaws.com/fd-8066/wave-cache'
    }
}
fusion {
    enabled   = true
    snapshots = true
}
