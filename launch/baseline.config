// Shared by both runs. ECR in the same AWS account and region as the compute environment. No
// container-reg credential matches this host, so Wave pushes with the CE AWS credential (as Ionis does).
wave {
    enabled = true
    freeze  = true
    build {
        repository      = '128997144437.dkr.ecr.eu-west-1.amazonaws.com/fd-8066/wave'
        cacheRepository = '128997144437.dkr.ecr.eu-west-1.amazonaws.com/fd-8066/wave-cache'
    }
}
fusion {
    enabled   = true
    snapshots = true
}
// Baseline: default Fusion for NF 26.04 with snapshots => v2.5-snap_amd64.json (Fusion 2.5.15 + fusion-snapshot 1.8.0). Expect execvp failure.
